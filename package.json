{
	"name": "car-organizer",
	"version": "1.0.0",
	"description": "Car search tracker",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"migrate": "node --env-file=.env scripts/migrate.js"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.104.0",
		"cheerio": "^1.2.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^22.10.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.1.0",
		"typescript": "^5.6.0",
		"vite": "^8.0.9",
		"vitest": "^4.1.5"
	}
}
