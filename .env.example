# Supabase — find these in your dashboard: Settings → API → "Publishable and secret API keys" tab.
# Publishable key (sb_publishable_…) is safe to expose to the browser; respects RLS.
# Secret key (sb_secret_…) is server-only — bypasses RLS, never expose to the browser.
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
